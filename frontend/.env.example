NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Secret path for the admin sign-in page, e.g. /k7Qx2mP9vR4tW8zBn3Lc5Hd. At least 16 letters/digits.
# When set, /admin/login returns 404. Use the same value in frontend/.env.local and backend/.env.
ADMIN_LOGIN_PATH=
