FROM node:22-alpine

WORKDIR /usr/src/app

ARG NEXT_PUBLIC_API_URL=http://backend:5000
ARG INTERNAL_API_URL=http://backend:5000
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Install exactly what the lockfile pins
COPY frontend/package*.json ./
RUN npm ci && npm cache clean --force

COPY frontend/. ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN set -a \
	&& [ -f .env.local ] && . ./.env.local || true \
	&& set +a \
	&& npm run build \
	&& chown -R node:node /usr/src/app/.next

# Run as the unprivileged "node" user instead of root
USER node

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
